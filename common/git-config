[user]
	name = kya
	email = <>
[credential "https://github.com"]
	username = kya8

[alias]
    co = checkout
    cl = clone
    st = status
    s  = status --short --branch
    ss = stash
    a  = add
    sh = show
    br = branch
    cm = commit
    cma = commit --amend
    sw = switch
    rb = rebase
    re = reset
    rs = restore
    mg = merge
    fe = fetch
    pl = pull
    ps = push
    l  = log --oneline --graph
    ll = log --oneline --graph --all
    d  = diff
    ds = diff --staged
    sm = submodule

[log]
    date = iso

[rebase]
	autoSquash = true

[status]
        showStash = true
     ; relativePaths = false

