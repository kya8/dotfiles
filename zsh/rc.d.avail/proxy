proxy_set() {
    my_proxy=${my_proxy:-http://127.0.0.1:1080}
    export all_proxy="${my_proxy}" http_proxy="${my_proxy}" https_proxy="${my_proxy}"
}

proxy_unset() {
    unset all_proxy
    unset http_proxy
    unset https_proxy
    unset ALL_PROXY
    unset HTTP_PROXY
    unset HTTPS_PROXY
}

proxy_set
