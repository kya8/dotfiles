font-family = JetBrains Mono NL
font-family = Sarasa Fixed SC
font-size = 15

theme = Adwaita Dark
macos-titlebar-style = tabs

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

macos-option-as-alt = left

quit-after-last-window-closed = true

window-inherit-working-directory = false

term = ghostty

unfocused-split-opacity = 0.8

# keybind = global:opt+t=toggle_quick_terminal
keybind = super+d=new_split:auto
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_right=goto_split:right
keybind = super+alt+arrow_down=goto_split:down
keybind = super+alt+arrow_up=goto_split:up
keybind = super+arrow_left=previous_tab
keybind = super+arrow_right=next_tab


# bold+bright color for intense text
bold-color=bright

split-divider-color=004b92

config-file = ?config.local


